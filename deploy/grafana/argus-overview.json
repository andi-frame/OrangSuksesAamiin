{
 "uid": "argus-overview",
 "title": "Argus / Observabilitas",
 "tags": [
  "argus",
  "m2"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "description": "Satu dashboard metrik untuk setiap service (M2). Trace: Explore -> Jaeger, cari trace_id dari log atau header traceparent.",
 "links": [
  {
   "title": "Jaeger (trace)",
   "url": "/explore?left=%7B%22datasource%22:%22jaeger%22%7D",
   "type": "link"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Setiap service: throughput, error rate, latensi (kriteria Observabilitas 1)",
   "collapsed": false,
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Throughput per service (req/s)",
   "description": "Permintaan masuk per detik per service (semua pod).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (app) (rate(http_server_requests_total[1m]))",
     "legendFormat": "{{app}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
