# =============================================================================
# Copy to .env and adjust:   cp .env.example .env      (make up does it for you)
# .env is git-ignored. Every value below is an EXAMPLE, never a real secret.
# Credentials of different domains are deliberately independent: the BMKG key,
# the PVMBG token/secret and the internal service key are not interchangeable.
# =============================================================================

# ---- BMKG mock (port 8081) --------------------------------------------------
BMKG_PORT=8081
# credential the BMKG mock accepts (header X-BMKG-Key); the Aggregator holds the same value
BMKG_API_KEY=example-bmkg-api-key-change-me
# operator token for BMKG /admin/* (header X-Admin-Token)
BMKG_ADMIN_TOKEN=example-bmkg-admin-token
BMKG_DELAY_MIN_MS=50
BMKG_DELAY_MAX_MS=150
# one new seismic event per interval (spec: at least 1 per 10 s; lower it to speed a demo up)
BMKG_EVENT_INTERVAL_SEC=10
# a tsunami warning is issued this long AFTER its event (exercises late correlation)
BMKG_WARNING_DELAY_MIN_SEC=2
BMKG_WARNING_DELAY_MAX_SEC=8
BMKG_SEED_COUNT=24

# ---- PVMBG mock (port 8082) -------------------------------------------------
PVMBG_PORT=8082
# secret PVMBG signs its access tokens with. Only the PVMBG mock knows it.
PVMBG_TOKEN_SECRET=example-pvmbg-signing-secret-change-me
# token the Aggregator presents (Authorization: Bearer ...). Mint a new one with:
#   PVMBG_TOKEN_SECRET=<secret> go run ./tools/pvmbg-token     (or: make pvmbg-token)
PVMBG_GATEWAY_TOKEN=pvmbg.v1.eyJhdWQiOiJwdm1iZy1hcGkiLCJleHAiOjIxMDYwODYxNTYsImlhdCI6MTc5MDcyNjE1NiwiaXNzIjoicHZtYmctZ2VvbG9naSIsInN1YiI6ImJucGItYWdncmVnYXRvciJ9.o9BANF1Nam2PE5qngqSOuFXXdLK-P7VvmMPByWtvPzU
# operator token for PVMBG /admin/* (schema switch, outage, delay, generate)
PVMBG_ADMIN_TOKEN=example-pvmbg-admin-token
# random response delay range (spec: 500 ms - 3 s); also changeable at runtime via POST /admin/delay
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
PVMBG_REPORT_INTERVAL_SEC=10
PVMBG_SEED_COUNT=24
# how long a "hang" outage holds a request before giving up
PVMBG_HANG_MAX_SEC=60

# ---- Aggregator (internal API on 8083, bound to 127.0.0.1 only) --------------
AGGREGATOR_PORT=8083
# credential of the internal read API (header X-Service-Key); used by the Client-Facing API
AGGREGATOR_SERVICE_KEY=example-aggregator-service-key
# polling: interval between the END of one cycle and the start of the next (spec: 2-5 s suggested)
POLL_INTERVAL_SEC=3
# re-request this much before the watermark (records arriving slightly out of order are not missed)
POLL_OVERLAP_SEC=5
# per-request timeout towards a source
SOURCE_TIMEOUT_SEC=5
# circuit breaker per source: open after N consecutive failures, probe again after N seconds
BREAKER_FAILURE_THRESHOLD=3
BREAKER_OPEN_SEC=10
# how long a tsunami warning may wait for its (not yet seen) event before it is quarantined
PENDING_WARNING_TTL_SEC=120
# backends: REPOSITORY_BACKEND = memory | postgres     PUBLISHER_BACKEND = log | kafka
REPOSITORY_BACKEND=postgres
PUBLISHER_BACKEND=kafka
RELAY_INTERVAL_MS=500
RELAY_BATCH=100
RELAY_MAX_BACKOFF_SEC=10
LOG_LEVEL=info

# ---- Canonical Store (PostgreSQL, reachable ONLY by the Aggregator) ----------
CANONICAL_DB_USER=canonical
CANONICAL_DB_PASSWORD=example-canonical-db-password
CANONICAL_DB_NAME=canonical

# ---- Message broker (Kafka, KRaft, single broker) -----------------------------
KAFKA_TOPIC=hazard.events
KAFKA_PARTITIONS=3
# retention: events older than this are gone even for consumers that were down (7 days)
KAFKA_RETENTION_MS=604800000
